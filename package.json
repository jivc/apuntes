{
  "name": "apuntes",
  "productName": "Apuntes",
  "version": "0.3.0",
  "description": "Notas Markdown hermosas, sincronizadas con una carpeta de Dropbox.",
  "main": "main.js",
  "author": {
    "name": "Julio Vega",
    "email": "apuntes@correo.invalid"
  },
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --watch",
    "dist": "node build.mjs && electron-builder",
    "dist:mac": "node build.mjs && electron-builder --mac",
    "dist:win": "node build.mjs && electron-builder --win",
    "dist:linux": "node build.mjs && electron-builder --linux",
    "build:test": "node build.mjs --test"
  },
  "build": {
    "appId": "com.juliovega.apuntes",
    "productName": "Apuntes",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "apuntes",
      "synopsis": "Notas Markdown sincronizadas con Dropbox",
      "desktop": {
        "entry": {
          "Name": "Apuntes",
          "StartupWMClass": "Apuntes"
        }
      },
      "extraFiles": [
        {
          "from": "build/icon.png",
          "to": "apuntes.png"
        }
      ]
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Apuntes",
      "artifactName": "Apuntes-Setup-${version}.${ext}"
    },
    "artifactName": "Apuntes-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0"
  },
  "homepage": "https://github.com/"
}
